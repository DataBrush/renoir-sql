WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

// SQL comments (line comments starting with --)
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }

select = { "SELECT" }
distinct_keyword = { "DISTINCT" }
from = { "FROM" }
where_keyword = { "WHERE" }
as_keyword = { "AS" }
join = { "JOIN" }
on = { "ON" }
asterisk = { "*" }
group_by_keyword = { "GROUP BY" }
having_keyword = { "HAVING" }
order_by_keyword = { "ORDER BY" }
limit_keyword = { "LIMIT" }
offset_keyword = { "OFFSET" }

// DDL keywords
create_keyword = { ^"CREATE" }
source_keyword = { ^"SOURCE" }
sink_keyword = { ^"SINK" }
insert_keyword = { ^"INSERT" }
into_keyword = { ^"INTO" }
with_keyword = { ^"WITH" }

in_keyword = @{ ^"NOT IN" | ^"IN" }
exists_keyword = @{ ^"NOT EXISTS" | ^"EXISTS" }

l_paren = @{ "(" }
r_paren = @{ ")" }

boolean = { "true" | "false"}

variable = @{ ('a'..'z' | 'A'..'Z'| "_") ~ (('a'..'z' | 'A'..'Z'| '0'..'9' | "_"))* }
number = @{ ("-")? ~
    ('0'..'9')+ // Integer part
    ~ ("." ~ ('0'..'9')+)? // Optional decimal part
}
symbol = @{ ("^"| "+" | "-" | "*" | "/")}

// Aggregate function definition
agg_function = { ("MAX" | "MIN" | "AVG" | "SUM" | "COUNT") }
aggregate_expr = { agg_function ~ "(" ~ (asterisk | table_column | variable) ~ ")" }

operator = @{ ">=" | "<=" | "!=" | "<>" | ">" | "<" | "=" }
null_operator = @ { "IS NOT NULL" | "IS NULL" }

binary_op = { 
    ^"AND" | 
    ^"OR"
}

table_column = {
    variable ~ "." ~ variable
}

spaced_string = @{ ('a'..'z' | 'A'..'Z' | '0'..'9' | " " | "-" | "_" | "#" | "*" | "%" | "&" | "/" | "\\" | ":" | "." | ",")* }
string_literal = @{ "'" ~ spaced_string ~ "'" }

// Data types for CREATE statements
data_type = { 
    ^"INTEGER" | ^"i32" |
    ^"BIGINT" | ^"i64" |
    ^"FLOAT" | ^"f32" |
    ^"DOUBLE" | ^"f64" |
    ^"STRING" | ^"String" |
    ^"BOOLEAN" | ^"bool" | ^"BOOL" |
    ^"TIMESTAMP" 
}

// Arithmetic expression components
arithmetic_expr = {
    (arithmetic_term ~ (symbol ~ arithmetic_term)*) | subquery_expr
}

arithmetic_term = {
    l_paren ~ arithmetic_expr ~ r_paren |
    arithmetic_factor
}

arithmetic_factor = {
    aggregate_expr |
    table_column |
    variable |
    number |
    string_literal |
    boolean |
    subquery_expr
}

exists_expr = { exists_keyword ~ subquery_expr }
in_expr = { (arithmetic_expr | subquery_expr) ~ in_keyword ~ subquery_expr }


condition = {
    exists_expr |
    in_expr |
    arithmetic_expr ~ operator ~ arithmetic_expr | 
    arithmetic_expr ~ null_operator |
    boolean
}

where_conditions = { where_term ~ (binary_op ~ where_term)* }
where_term = { 
    l_paren ~ where_conditions ~ r_paren |
    condition
}
where_expr = { where_keyword ~ where_conditions }

column_item = {
    select_expr |
    aggregate_expr |
    table_column | 
    variable | 
    string_literal |
    subquery_expr 
}

column_with_alias = { column_item ~ (as_keyword ~ variable)? }
column_list = { (column_with_alias ) ~ ("," ~ (column_with_alias ))* }
select_expr = { 
    (parenthesized_expr | column_operand) ~ 
    (symbol ~ (parenthesized_expr | column_operand))*
}

column_operand = {aggregate_expr | table_column | variable | number | subquery_expr}
parenthesized_expr = { l_paren ~ select_expr ~ r_paren }

// Having clause
having_term = { 
    l_paren ~ having_expr ~ r_paren |
    condition
}
having_expr = { having_term ~ (binary_op ~ having_term)* }

// Group by 
group_by_list = { (table_column | variable) ~ ("," ~ (table_column | variable))* }
group_by_expr = { group_by_keyword ~ group_by_list ~ ( having_keyword ~ having_expr )? }


join_condition = { table_column ~ "=" ~ table_column ~ ("AND" ~ table_column ~ "=" ~ table_column)* }

// Reserved SQL keywords that cannot be used as aliases
keyword = @{
    where_keyword | group_by_keyword | order_by_keyword | limit_keyword |
    join | on | select | from | as_keyword | having_keyword | offset_keyword |
    create_keyword | source_keyword | sink_keyword | insert_keyword | into_keyword | with_keyword
}

alias = @{ !keyword ~ variable }

from_expr = { from ~ scan_expr ~ join_expr* }
scan_expr = { (variable | subquery_expr) ~ (as_keyword ~ alias | alias)? }
join_expr = { join_kind? ~ join ~ (scan_expr | subquery_expr) ~ on ~ join_condition }
join_kind = { ( ^"INNER" | (^"LEFT" ~ (^"OUTER")?) | ^"OUTER") }

order_direction = { ^"ASC" | ^"DESC" }
nulls_handling = { ^"NULLS FIRST" | ^"NULLS LAST"}
order_item = { (table_column | variable) ~ order_direction? ~ nulls_handling?}
order_by_list = { order_item ~ ("," ~ order_item)* }
order_by_expr = { order_by_keyword ~ order_by_list }
            
limit_expr = { 
    limit_clause ~ offset_clause? 
}

limit_clause = { limit_keyword ~ number }
offset_clause = { offset_keyword ~ number }

subquery_expr = { l_paren ~ 
    select ~ distinct_keyword? ~ (asterisk | column_list ) ~
    from_expr ~
    where_expr? ~
    group_by_expr? ~
    order_by_expr? ~
    limit_expr? ~
    r_paren }

query = {
    select ~ distinct_keyword? ~ (asterisk | column_list ) ~
    from_expr ~
    where_expr? ~
    group_by_expr? ~
    order_by_expr? ~
    limit_expr?
}

// Field definition for CREATE statements
field_def = { variable ~ data_type }
field_list = { field_def ~ ("," ~ field_def)* }

// WITH clause for connector options
option_value = { string_literal | number | boolean | variable }
option_pair = { variable ~ "=" ~ option_value }
option_list = { option_pair ~ ("," ~ option_pair)* }
with_clause = { with_keyword ~ l_paren ~ option_list ~ r_paren }

// CREATE SOURCE statement
create_source = { 
    create_keyword ~ source_keyword ~ variable ~ 
    l_paren ~ field_list ~ r_paren ~ 
    with_clause 
}

// CREATE SINK statement
create_sink = { 
    create_keyword ~ sink_keyword ~ variable ~ 
    l_paren ~ field_list ~ r_paren ~ 
    with_clause 
}

// INSERT INTO statement
column_name_list = { variable ~ ("," ~ variable)* }
insert_into = {
    insert_keyword ~ into_keyword ~ variable ~ 
    (l_paren ~ column_name_list ~ r_paren)? ~
    query
}

// Statement types
statement = { create_source | create_sink | insert_into | query }

// Multi-statement program
program = { 
    SOI ~ 
    statement ~ (";" ~ statement)* ~ ";"? ~ 
    EOI 
}